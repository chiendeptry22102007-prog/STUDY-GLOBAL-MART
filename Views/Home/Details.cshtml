@model Product
<div class="row g-4 glass-card p-3 p-md-4"><div class="col-md-6"><img class="img-fluid rounded-4 w-100" style="max-height:500px;object-fit:contain;background:#09182a" src="@Model.ImageUrl" alt="@Model.Name"></div><div class="col-md-6 d-flex flex-column justify-content-center"><div class="hero-label"><i class="bi bi-patch-check"></i> SẢN PHẨ STUDY MARK</div><h1 class="fw-bold">@Model.Name</h1><p class="section-sub">@Model.Category?.Name</p><h2 class="price my-3">@Model.Price.ToString("N0") ₫</h2><p>@Model.Description</p><p><i class="bi bi-box-seam"></i> Tồn kho: @Model.Stock</p><a class="btn btn-brand btn-lg" href="/Cart/Add/@Model.Id"><i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng</a><a href="/" class="btn btn-outline-primary mt-2">← Tiếp tục mua sắm</a></div></div>