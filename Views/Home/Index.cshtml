@model List<Product>
<section class="hero mb-4"><div class="hero-label"><i class="bi bi-stars"></i> ƯU ĐÃI & SẢN PHẨ MỚI</div><h1>STUDY MARK<br><span style="background:linear-gradient(90deg,#64c8ff,#6ff3df);-webkit-background-clip:text;color:transparent">Mua sắm thông minh</span></h1><p>Thiết bị điện tử, điện lạnh và gia dụng chính hãng.<br>Chọn sản phẩm tốt – nâng cấp cuộc sống mỗi ngày.</p><a href="#products" class="btn btn-brand btn-lg"><i class="bi bi-arrow-right-circle"></i> Khám phá ngay</a></section>
<div class="glass-card p-3 mb-4"><form class="row g-2"><div class="col-md-8"><input name="q" class="form-control" placeholder="Tìm tên sản phẩm bạn cần..." value="@ViewBag.Query"></div><div class="col-md-3"><select name="categoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach(Category c in ViewBag.Categories){<option value="@c.Id" selected="@(ViewBag.CategoryId==c.Id)">@c.Name</option>}</select></div><div class="col-md-1"><button class="btn btn-primary w-100"><i class="bi bi-search"></i></button></div></form></div>
<h3 class="section-title mb-1" id="products"><i class="bi bi-lightning-charge-fill" style="color:#5ee6e0"></i> Sản phẩm nổi bật</h3><p class="section-sub mb-3">Sản phẩm được lựa chọn cho không gian sống hiện đại</p>
<div class="row g-3">@foreach(var p in Model){<div class="col-12 col-sm-6 col-lg-4"><div class="card product-card h-100"><img src="@p.ImageUrl" class="card-img-top product-img" alt="@p.Name"><div class="card-body d-flex flex-column"><small class="text-muted mb-2">@p.Category?.Name</small><h5 class="fw-bold">@p.Name</h5><strong class="price mb-2">@p.Price.ToString("N0") ₫</strong><p class="text-muted flex-grow-1">@p.Description</p><div class="d-flex gap-2"><a href="/Home/Details/@p.Id" class="btn btn-outline-primary flex-grow-1">Chi tiết</a><a href="/Cart/Add/@p.Id" class="btn btn-primary flex-grow-1"><i class="bi bi-bag-plus"></i> Thêm giỏ</a></div></div></div></div>}</div>
