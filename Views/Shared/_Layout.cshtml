<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>STUDY MARK | Điện máy & Gia dụng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="/css/site.css" rel="stylesheet">
</head>

<body>

    <!-- BACKGROUND -->
    <div class="ambient-bg">
        <span class="orb orb1"></span>
        <span class="orb orb2"></span>
        <span class="orb orb3"></span>
        <div class="grid-glow"></div>
    </div>

    <!-- HEADER -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark container py-3">

            <a class="navbar-brand brand-mark" href="/">
                <span class="brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </span>

                <span>
                    STUDY<span class="brand-accent">MARK</span>
                    <small>SMART SHOPPING</small>
                </span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">

                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <a class="nav-link" href="/">
                        <i class="bi bi-house-door"></i>
                        Trang chủ
                    </a>

                    <a class="nav-link" href="/Cart">
                        <i class="bi bi-bag"></i>
                        Giỏ hàng
                    </a>

                    <a class="nav-link" href="/Orders">
                        <i class="bi bi-receipt"></i>
                        Đơn hàng
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-user">
                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name
                        </span>

                        <a class="nav-link" href="/Account/Logout">
                            Đăng xuất
                        </a>
                    }
                    else
                    {
                        <a class="nav-link" href="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Đăng nhập
                        </a>

                        <a class="btn btn-brand btn-sm" href="/Account/Register">
                            Tạo tài khoản
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-light btn-sm" href="/Admin">
                            <i class="bi bi-speedometer2"></i>
                            Admin
                        </a>
                    }

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">

            <div>
                <strong>STUDY MARK</strong>

                <div class="footer-muted">
                    Mua sắm thông minh – nâng tầm không gian sống
                </div>
            </div>

            <div class="footer-muted">
                © STUDY MARK • Điện tử • Điện lạnh • Gia dụng • Nhà bếp
            </div>

        </div>
    </footer>

    <!-- BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ================= HAVEN AI CHAT ================= -->

    <div id="haven-ai">

        <!-- CHAT BUTTON -->
        <button id="chat-toggle"
                type="button"
                class="gift-globe-btn"
                title="Chat với Haven AI"
                aria-label="Mở chatbot Haven AI">

            <span class="gift-globe-icon">🌎🎁</span>

        </button>


        <!-- CHAT WINDOW -->
        <div id="haven-ai-box">

            <!-- HEADER -->
            <div class="haven-ai-header">

                <div>
                    <strong>✨ Haven AI</strong>
                    <small>Trợ lý tư vấn thông minh</small>
                </div>

                <button id="haven-ai-close"
                        type="button"
                        aria-label="Đóng chatbot">
                    ×
                </button>

            </div>


            <!-- MESSAGES -->
            <div id="haven-ai-messages">

                <div class="haven-ai-message bot">
                    Xin chào 👋 Tôi là Haven AI.
                    Bạn cần tư vấn gì hôm nay?
                </div>

            </div>


            <!-- INPUT -->
            <div class="haven-ai-input">

                <input id="haven-ai-text"
                       type="text"
                       placeholder="Nhập câu hỏi của bạn..."
                       autocomplete="off">

                <button id="haven-ai-send" type="button">
                    <i class="bi bi-send-fill"></i>
                </button>

            </div>

        </div>

    </div>


    <!-- ================= CHAT JAVASCRIPT ================= -->

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const toggle = document.getElementById("chat-toggle");
                const chatBox = document.getElementById("haven-ai-box");
                const closeBtn = document.getElementById("haven-ai-close");

                const input = document.getElementById("haven-ai-text");
                const sendBtn = document.getElementById("haven-ai-send");
                const messages = document.getElementById("haven-ai-messages");

                if (!toggle || !chatBox || !closeBtn || !input || !sendBtn || !messages) {
                    console.error("Không tìm thấy thành phần chatbot Haven AI.");
                    return;
                }

                // MỞ CHAT
                toggle.addEventListener("click", function (event) {
                    event.preventDefault();

                    chatBox.classList.toggle("active");

                    if (chatBox.classList.contains("active")) {
                        input.focus();
                    }
                });

                // ĐÓNG CHAT
                closeBtn.addEventListener("click", function () {
                    chatBox.classList.remove("active");
                });

                // THÊM TIN NHẮN
                function addMessage(text, type) {

                    const message = document.createElement("div");

                    message.className = "haven-ai-message " + type;
                    message.textContent = text;

                    messages.appendChild(message);

                    messages.scrollTop = messages.scrollHeight;

                    return message;
                }

                // GỬI TIN NHẮN
                async function sendMessage() {

                    const text = input.value.trim();

                    if (!text || sendBtn.disabled) {
                        return;
                    }

                    addMessage(text, "user");

                    input.value = "";

                    sendBtn.disabled = true;

                    const loadingMessage = addMessage("AI đang trả lời...", "bot");

                    try {

                        const response = await fetch("/AI/Chat", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                message: text
                            })
                        });

                        const result = await response.json();

                        loadingMessage.remove();

                        if (result.success) {
                            addMessage(result.message, "bot");
                        }
                        else {
                            addMessage(
                                result.message || "AI hiện chưa trả lời được.",
                                "bot"
                            );
                        }

                    }
                    catch (error) {

                        loadingMessage.remove();

                        addMessage(
                            "Không kết nối được với AI. Vui lòng thử lại.",
                            "bot"
                        );

                        console.error("Lỗi chatbot:", error);
                    }
                    finally {

                        sendBtn.disabled = false;
                        input.focus();

                    }
                }

                // CLICK GỬI
                sendBtn.addEventListener("click", sendMessage);

                // NHẤN ENTER ĐỂ GỬI
                input.addEventListener("keydown", function (event) {

                    if (event.key === "Enter") {
                        event.preventDefault();
                        sendMessage();
                    }

                });

            });
    </script>

</body>
</html>