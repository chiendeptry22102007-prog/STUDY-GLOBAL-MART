<div class="auth-shell"><div class="auth-card"><div class="auth-icon"><i class="bi bi-person-lock"></i></div><h2 class="auth-title">Chào mừng trở lại</h2><p class="auth-sub">Đăng nhập vào tài khoản STUDY MARK</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}<form method="post" action="/Account/Login"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><label class="form-label mt-3">Email</label><input class="form-control mb-3" name="email" type="email" placeholder="example@email.com" autocomplete="email" required><label class="form-label">Mật khẩu</label><input class="form-control mb-3" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required><button class="btn btn-brand w-100 py-3" type="submit"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</button></form><div class="text-center mt-4 auth-sub">Bạn chưa có tài khoản? <a class="auth-switch fw-bold" href="/Account/Register">Đăng ký ngay</a></div></div></div>