@model List<Product>
<h2>Quản lý sản phẩm</h2><form method="post" action="/Admin/SaveProduct" class="card card-body mb-4 row g-2"><h5>Thêm sản phẩm</h5><div class="col"><input name="name" class="form-control" placeholder="Tên sản phẩm" required></div><div class="col"><input name="price" type="number" step="1000" class="form-control" placeholder="Giá" required></div><div class="col"><input name="stock" type="number" class="form-control" placeholder="Tồn kho" required></div><div class="col"><select name="categoryId" class="form-select">@foreach(Category c in ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select></div><div class="col"><input name="imageUrl" class="form-control" placeholder="URL ảnh"></div><div class="col"><input name="description" class="form-control" placeholder="Mô tả"></div><div class="col form-check"><input name="featured" type="checkbox" value="true" class="form-check-input"><label class="form-check-label">Nổi bật</label></div><button class="btn btn-primary">Lưu sản phẩm</button></form><table class="table table-striped"><thead><tr><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category?.Name</td><td>@p.Price.ToString("N0")</td><td>@p.Stock</td><td><a class="btn btn-sm btn-danger" href="/Admin/DeleteProduct/@p.Id">Xóa</a></td></tr>}</tbody></table>