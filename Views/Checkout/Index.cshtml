@model List<CartItem>
<h2>Thanh toán / Đặt hàng</h2><p>Tổng đơn: <b>@Model.Sum(x=>x.Price*x.Quantity).ToString("N0") ₫</b></p><form method="post" action="/Checkout/Place" class="row g-3"><div class="col-md-6"><input name="name" class="form-control" placeholder="Họ tên nhận hàng" required></div><div class="col-md-6"><input name="phone" class="form-control" placeholder="Số điện thoại" required></div><div class="col-12"><textarea name="address" class="form-control" placeholder="Địa chỉ giao hàng" required></textarea></div><div class="col-12"><select name="payment" class="form-select"><option value="COD">Thanh toán khi nhận hàng (COD)</option><option value="Bank">Chuyển khoản</option></select></div><button class="btn btn-success">Xác nhận đặt hàng</button></form>